# Set these before running the seed. Use Atlas for deployment.
MONGODB_URI=mongodb://127.0.0.1:27017/advocate_vishnu_sharma
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@advocatevishnusharma.com
ADMIN_PASSWORD=replace-with-a-unique-strong-password
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: for persistent image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# For production, keep hybrid while adding records; switch to database later.
MONGODB_CONTENT_MODE=hybrid

# AI BLOG STUDIO — server-only; never use NEXT_PUBLIC_ prefix for secrets
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Daily draft runs only on deployed scheduler (Vercel cron at 10 AM IST)
AUTO_BLOG_ENABLED=false
AUTO_BLOG_IMAGE=false
CRON_SECRET=replace-with-a-strong-unguessable-32-character-secret
